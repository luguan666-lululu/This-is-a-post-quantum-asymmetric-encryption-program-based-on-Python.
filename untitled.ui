             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;
&lt;p&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;&lt;b&gt;版本&lt;/b&gt;：v10.9&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;&lt;b&gt;密钥封装&lt;/b&gt;：ML-KEM-1024 + Classic McEliece-8192128&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;&lt;b&gt;对称加密&lt;/b&gt;：AES-256-GCM + ChaCha20-Poly1305 + AES-256-CBC&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;&lt;b&gt;数字签名&lt;/b&gt;：ML-DSA-87 + SLH-DSA-SHAKE-256f&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;&lt;b&gt;私钥保护&lt;/b&gt;：可选 Argon2id（256 MiB 内存）密码加密&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;&lt;b&gt;运行环境&lt;/b&gt;：Python 3.14&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:14pt;&quot;&gt;本程序为开源免费工具，未经权威机构安全审查，不对安全性做出任何承诺。&lt;/span&gt;&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string>
