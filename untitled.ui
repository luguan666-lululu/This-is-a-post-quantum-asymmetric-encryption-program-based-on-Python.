     <property name="styleSheet">
      <string notr="true">QTabBar::tab {
    background: transparent;
    border: 1px solid palette(mid);
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    font-size: 12pt;
}
QTabBar::tab:selected {
    background: #E65100;
    color: #FFFFFF;
    font-weight: 700;
    border: 2px solid #E65100;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:hover:!selected {
    background: palette(light);
}</string>
     </property>

     <!-- ========== 页1：程序说明 ========== -->
     <widget class="QWidget" name="tab_manual">
      <attribute name="title">
       <string>程序说明</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_manual">
       <item>
        <widget class="QScrollArea" name="scrollArea_manual">
         <property name="widgetResizable">
          <bool>true</bool>
         </property>
         <widget class="QWidget" name="scrollAreaWidgetContents_manual">
          <layout class="QVBoxLayout" name="verticalLayout_scroll_manual">
           <item>
            <widget class="QLabel" name="label_manual">
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;
&lt;p&gt;&lt;span style=&quot; font-size:15pt; font-weight:700;&quot;&gt;后量子加密程序 — 使用说明&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;这是一个「离线」加密工具：所有文件在本机处理，密文由你手动上传云端发给对方。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt; font-weight:700;&quot;&gt;第一步：生成密钥&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;输入一个名字（如 &quot;Alice&quot;），程序生成 &lt;b&gt;Alice——私钥&lt;/b&gt; 和 &lt;b&gt;Alice——公钥&lt;/b&gt;。生成时可选择为私钥设置密码。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt; font-weight:700;&quot;&gt;第二步：交换公钥&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;把你的 &lt;b&gt;公钥&lt;/b&gt; 发给对方，同时收下对方的公钥。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;&lt;b&gt;把对方公钥改名为对方在你这里的名字——公钥。&lt;/b&gt; 例如对方叫 Bob，就把 Bob 的公钥改名为 &lt;b&gt;Bob——公钥&lt;/b&gt;。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt; font-weight:700;&quot;&gt;第三步：加密（发给 Bob）&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;选择文件 → 输入 &lt;b&gt;对面名称&lt;/b&gt;（此处为 &quot;Bob&quot;）→ 程序用 &lt;b&gt;Bob——公钥&lt;/b&gt;（里面装的是 Bob 的公钥）加密。密文保存为 &lt;b&gt;文件——密文&lt;/b&gt;。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt; font-weight:700;&quot;&gt;第四步：解密（收 Alice 的文件）&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;把收到的密文命名为 &lt;b&gt;文件——密文&lt;/b&gt; 放入程序目录 → 输入&lt;b&gt;对面名称&lt;/b&gt;（发送方在你这里的名字，如 &quot;Alice&quot;）→ 程序用 &lt;b&gt;Alice——公钥&lt;/b&gt;（里面是 Alice 的公钥）验签。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt; font-weight:700;&quot;&gt;关键注意：&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;· 所有密钥、密文文件都必须与程序放在&lt;b&gt;同一目录&lt;/b&gt;。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;· 私钥 = 你的身份。任何拿到你私钥的人都能冒充你签名、解开通往你的密文，请勿泄露。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;· 若私钥设置了密码，加密/解密时会弹出密码框；忘记密码则私钥永久作废。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;· 大文件处理期间界面可能无响应，请耐心等待，勿强制终止。&lt;/span&gt;&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>

